<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0;</TargetFrameworks>
		<StrongNamePublicKey>$(StrongNamePublicKey)</StrongNamePublicKey>
		<DocumentationFile>$(DocumentationFile)\$(AssemblyName).xml</DocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Microsoft.Restier.AspNetCore\Microsoft.Restier.AspNetCore.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.OpenApi.OData" Version="[3.*, 4.0.0)" />
		<!-- Microsoft.OpenApi.OData 3.x pulls in Microsoft.OpenApi 3.5.1 transitively, which has a
		     high-severity advisory (GHSA-v5pm-xwqc-g5wc, patched in 3.5.4). Pin it forward so the
		     NuGetAudit restore stays clean; the floor still satisfies OpenApi.OData's dependency. -->
		<PackageReference Include="Microsoft.OpenApi" Version="[3.5.4, 4.0.0)" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.*" />
	</ItemGroup>

</Project>
